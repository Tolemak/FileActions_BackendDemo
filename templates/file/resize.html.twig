{% extends 'file/file_action.html.twig' %}

{% block title_action %}{{ 'resize.title'|trans }}{% endblock %}
{% block breadcrumb_action %}{{ 'resize.breadcrumb'|trans }}{% endblock %}

{% block header %}{{ 'resize.header'|trans }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ vite_entry_link_tags('appresize') }}
{% endblock %}

{% block javascripts_body %}
	{{ parent() }}
	{{ vite_entry_script_tags('appresize') }}
{% endblock %}

{% block description %}{{ 'resize.description'|trans }}{% endblock %}

{% block content %}
	<div class="text-center">
		<input type="file" class="filepond mb-4" name="filepond" accept="image/png, image/jpeg, image/gif" data-prompt-title="{{ 'resize.prompt_title'|trans }}" data-drop-label='{{ ('common.drop_label'|trans)|raw }}' style="--fp-accent-color: #0d6efd"/>
		<button class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm button-process"><i class="fas fa-crop-alt me-2"></i>{{ 'resize.button'|trans }}</button>
	</div>
{% endblock %}
