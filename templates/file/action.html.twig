{% extends 'file/file_action.html.twig' %}

{% set active_tool = action.name %}
{% set option = action.option %}

{% block title_action %}{{ (action.name ~ '.title')|trans }}{% endblock %}
{% block header %}{{ (action.name ~ '.header')|trans }}{% endblock %}
{% block description %}{{ (action.name ~ '.description')|trans }}{% endblock %}

{% block javascripts_body %}
	{{ parent() }}
	{{ vite_entry_script_tags('appaction') }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ vite_entry_link_tags('appaction') }}
{% endblock %}

{% block sheet %}
	<input type="file" class="filepond" name="filepond" accept="image/png, image/jpeg, image/gif" data-action="{{ action.name }}" data-drop-label='{{ ('common.drop_label'|trans)|raw }}'
		{%- if option and option.type.value == 'range' %} data-option="range" data-min="{{ option.min }}" data-max="{{ option.max }}" data-step="{{ option.step }}" data-default="{{ option.default }}" data-prompt-title="{{ (action.name ~ '.prompt_title')|trans }}"
		{%- elseif option %} data-option="choice"
		{%- endif %}/>
	{% if option and option.type.value == 'choice' %}
		<div class="sheet-controls">
			<label for="action-option">{{ (action.name ~ '.option_label')|trans }}</label>
			<select id="action-option">
				{% for value, label in option.choices %}
					<option value="{{ value }}">{{ label }}</option>
				{% endfor %}
			</select>
		</div>
	{% endif %}
	<button type="button" class="cut-button button-process">{{ (action.name ~ '.button')|trans }}</button>
{% endblock %}
