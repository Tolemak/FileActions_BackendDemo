{% extends 'file/file_action.html.twig' %}

{% block title_action %}{{ 'compress.title'|trans }}{% endblock %}
{% block breadcrumb_action %}{{ 'compress.breadcrumb'|trans }}{% endblock %}

{% block header %}{{ 'compress.header'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ vite_entry_link_tags('appcompress') }}
{% endblock %}

{% block javascripts_body %}
    {{ parent() }}
    {{ vite_entry_script_tags('appcompress') }}
{% endblock %}

{% block description %}{{ 'compress.description'|trans }}{% endblock %}

{% block content %}
    <div class="text-center">
        <input type="file" class="filepond mb-4" name="filepond" accept="image/png, image/jpeg, image/gif" data-prompt-title="{{ 'compress.prompt_title'|trans }}" data-drop-label='{{ ('common.drop_label'|trans)|raw }}' style="--fp-accent-color: #198754"/>
        <button class="btn btn-success btn-lg rounded-pill px-5 shadow-sm button-process"><i class="fas fa-compress-arrows-alt me-2"></i>{{ 'compress.button'|trans }}</button>
    </div>
{% endblock %}
