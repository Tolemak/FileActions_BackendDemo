{% extends 'file/file_action.html.twig' %}

{% set active_tool = 'compress' %}

{% block title_action %}{{ 'compress.title'|trans }}{% endblock %}
{% block header %}{{ 'compress.header'|trans }}{% endblock %}
{% block description %}{{ 'compress.description'|trans }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ vite_entry_link_tags('appcompress') }}
{% endblock %}

{% block javascripts_body %}
	{{ parent() }}
	{{ vite_entry_script_tags('appcompress') }}
{% endblock %}

{% block sheet %}
	<input type="file" class="filepond" name="filepond" accept="image/png, image/jpeg, image/gif" data-prompt-title="{{ 'compress.prompt_title'|trans }}" data-drop-label='{{ ('common.drop_label'|trans)|raw }}'/>
	<button type="button" class="cut-button button-process">{{ 'compress.button'|trans }}</button>
{% endblock %}
