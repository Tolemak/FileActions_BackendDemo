<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
	<head>
		<meta charset="UTF-8">
		<title>
			File Actions Demo - {% block title_action %}File Action{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🛠️</text></svg>">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
		{% block stylesheets %}
			{{ vite_entry_link_tags('appmain') }} {# Include main styles for consistent header/footer if any #}
		{% endblock %}
		{% block javascripts_head %}{% endblock %}
	</head>
	<body
		class="bg-light py-5"
		data-i18n-cancel="{{ 'common.cancel'|trans }}"
		data-i18n-cancelled-title="{{ 'common.cancelled_title'|trans }}"
		data-i18n-cancelled-text="{{ 'common.cancelled_text'|trans }}"
		data-i18n-network-error-title="{{ 'js.network_error_title'|trans }}"
		data-i18n-network-error-text="{{ 'js.network_error_text'|trans }}"
	>
		<div class="container">
			<nav aria-label="breadcrumb" class="mb-4 d-flex justify-content-between align-items-center">
				<ol class="breadcrumb mb-0">
					<li class="breadcrumb-item"><a href="{{ path('app_view_main') }}"><i class="fas fa-home"></i> {{ 'nav.home'|trans }}</a></li>
					<li class="breadcrumb-item active" aria-current="page">{% block breadcrumb_action %}Action{% endblock %}</li>
				</ol>
				{% include 'file/_locale_switcher.html.twig' %}
			</nav>

			<div class="text-center">
				<h1 class="display-4 text-primary mb-3 fw-bold">
					{% block header %}File Action{% endblock %}
				</h1>
				<p class="lead text-muted col-md-8 mx-auto mb-5">
					{% block description %}{% endblock %}
				</p>
			</div>
			<div class="card shadow-lg p-4 p-md-5"> 
				{% block content %}{% endblock %}
			</div>
		</div>
		{% block javascripts_body %}
		{% endblock %}
	</body>
</html>
