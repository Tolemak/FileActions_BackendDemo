{% extends 'file/file_action.html.twig' %}

{% block title_action %}{{ 'rotate.title'|trans }}{% endblock %}
{% block breadcrumb_action %}{{ 'rotate.breadcrumb'|trans }}{% endblock %}

{% block header %}{{ 'rotate.header'|trans }}{% endblock %}

{% block stylesheets %}
	{{ parent() }} {# Inherit stylesheets from base template #}
	{{ vite_entry_link_tags('approtate') }}
{% endblock %}

{% block javascripts_body %}
	{{ parent() }}
	{{ vite_entry_script_tags('approtate') }}
{% endblock %}

{% block description %}{{ 'rotate.description'|trans }}{% endblock %}

{% block content %}
	<div class="text-center">
		<input type="file" class="filepond mb-4" name="filepond" accept="image/png, image/jpeg, image/gif" data-prompt-title="{{ 'rotate.prompt_title'|trans }}" data-drop-label='{{ ('common.drop_label'|trans)|raw }}' style="--fp-accent-color: #ffc107"/>
		<button class="btn btn-warning btn-lg rounded-pill px-5 shadow-sm button-process"><i class="fas fa-sync-alt me-2"></i>{{ 'rotate.button'|trans }}</button>
	</div>
{% endblock %}
