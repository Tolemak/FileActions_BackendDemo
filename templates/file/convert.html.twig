{% extends 'file/file_action.html.twig' %}

{% block title_action %}{{ 'convert.title'|trans }}{% endblock %}
{% block breadcrumb_action %}{{ 'convert.breadcrumb'|trans }}{% endblock %}

{% block header %}{{ 'convert.header'|trans }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ vite_entry_link_tags('appconvert') }}
{% endblock %}

{% block javascripts_body %}
	{{ parent() }}
	{{ vite_entry_script_tags('appconvert') }}
{% endblock %}

{% block description %}{{ 'convert.description'|trans }}{% endblock %}

{% block content %}
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6">
			<input type="file" class="filepond mb-4" name="filepond" accept="image/png, image/jpeg, image/gif" data-drop-label='{{ ('common.drop_label'|trans)|raw }}' style="--fp-accent-color: #6c757d"/>
			<div class="input-group mb-4">
				<label class="input-group-text" for="dest-extension"><i class="fas fa-file-export me-2"></i>{{ 'convert.target_format'|trans }}</label>
				<select class="form-select form-select-lg" id="dest-extension">
					<option value="jpeg">JPEG</option>
					<option value="png">PNG</option>
					<option value="gif">GIF</option>
				</select>
			</div>
			<div class="text-center">
				<button class="btn btn-secondary btn-lg rounded-pill px-5 shadow-sm button-process"><i class="fas fa-exchange-alt me-2"></i>{{ 'convert.button'|trans }}</button>
			</div>
		</div>
	</div>
{% endblock %}
