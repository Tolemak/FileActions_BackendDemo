{% extends 'file/file_action.html.twig' %}

{% set active_tool = 'convert' %}

{% block title_action %}{{ 'convert.title'|trans }}{% endblock %}
{% block header %}{{ 'convert.header'|trans }}{% endblock %}
{% block description %}{{ 'convert.description'|trans }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ vite_entry_link_tags('appconvert') }}
{% endblock %}

{% block javascripts_body %}
	{{ parent() }}
	{{ vite_entry_script_tags('appconvert') }}
{% endblock %}

{% block sheet %}
	<input type="file" class="filepond" name="filepond" accept="image/png, image/jpeg, image/gif" data-drop-label='{{ ('common.drop_label'|trans)|raw }}'/>
	<div class="sheet-controls">
		<label for="dest-extension">{{ 'convert.target_format'|trans }}</label>
		<select id="dest-extension">
			<option value="jpeg">JPEG</option>
			<option value="png">PNG</option>
			<option value="gif">GIF</option>
		</select>
	</div>
	<button type="button" class="cut-button button-process">{{ 'convert.button'|trans }}</button>
{% endblock %}
