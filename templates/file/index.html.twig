<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
	<head>
		<meta charset="UTF-8">
		<script>
			(function () {
				var stored = localStorage.getItem('theme');
				var theme = (stored === 'light' || stored === 'dark')
					? stored
					: (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.setAttribute('data-bs-theme', theme);
			})();
		</script>
		<title>
			{% block title %}{{ 'home.title'|trans }}{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🛠️</text></svg>">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
		{% block stylesheets %}
			{{ vite_entry_link_tags('appmain') }}
		{% endblock %}

		{% block javascripts %}
			{{ vite_entry_script_tags('appmain') }}
		{% endblock %}
	</head>
	<body class="text-center py-5">
		{% block body %}
			<div class="container">
				<div class="d-flex justify-content-end align-items-center gap-3 mb-2">
					{% include 'file/_theme_toggle.html.twig' %}
					{% include 'file/_locale_switcher.html.twig' %}
				</div>
				<header class="mb-5">
					<h1 class="display-3 text-primary mb-3 fw-bold">{{ 'home.heading'|trans }}</h1>
					<p class="lead text-muted col-md-8 mx-auto">
						{{ 'home.lead'|trans|raw }}
					</p>
				</header>

				<div class="row justify-content-center g-4">
					<div class="col-md-6 col-lg-4">
						<div class="action-card card h-100 shadow-sm">
							<div class="card-body d-flex flex-column align-items-center">
								<div class="action-icon mb-3"><i class="fas fa-crop-alt fa-3x text-primary"></i></div>
								<h5 class="card-title">{{ 'home.card.resize.title'|trans }}</h5>
								<p class="card-text text-muted small">{{ 'home.card.resize.text'|trans }}</p>
								<a href="{{ path('app_view_resize') }}" class="btn btn-primary mt-auto rounded-pill px-4">{{ 'home.card.resize.button'|trans }}</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-4">
						<div class="action-card card h-100 shadow-sm">
							<div class="card-body d-flex flex-column align-items-center">
								<div class="action-icon mb-3"><i class="fas fa-exchange-alt fa-3x text-secondary"></i></div>
								<h5 class="card-title">{{ 'home.card.convert.title'|trans }}</h5>
								<p class="card-text text-muted small">{{ 'home.card.convert.text'|trans }}</p>
								<a href="{{ path('app_view_convert') }}" class="btn btn-secondary mt-auto rounded-pill px-4">{{ 'home.card.convert.button'|trans }}</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-4">
						<div class="action-card card h-100 shadow-sm">
							<div class="card-body d-flex flex-column align-items-center">
								<div class="action-icon mb-3"><i class="fas fa-compress-arrows-alt fa-3x text-success"></i></div>
								<h5 class="card-title">{{ 'home.card.compress.title'|trans }}</h5>
								<p class="card-text text-muted small">{{ 'home.card.compress.text'|trans }}</p>
								<a href="{{ path('app_view_compress') }}" class="btn btn-success mt-auto rounded-pill px-4">{{ 'home.card.compress.button'|trans }}</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-4">
						<div class="action-card card h-100 shadow-sm">
							<div class="card-body d-flex flex-column align-items-center">
								<div class="action-icon mb-3"><i class="fas fa-sync-alt fa-3x text-warning"></i></div>
								<h5 class="card-title">{{ 'home.card.rotate.title'|trans }}</h5>
								<p class="card-text text-muted small">{{ 'home.card.rotate.text'|trans }}</p>
								<a href="{{ path('app_view_rotate') }}" class="btn btn-warning mt-auto rounded-pill px-4">{{ 'home.card.rotate.button'|trans }}</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-4">
						<div class="action-card card h-100 shadow-sm">
							<div class="card-body d-flex flex-column align-items-center">
								<div class="action-icon mb-3"><i class="fas fa-palette fa-3x text-danger"></i></div>
								<h5 class="card-title">{{ 'home.card.sepia.title'|trans }}</h5>
								<p class="card-text text-muted small">{{ 'home.card.sepia.text'|trans }}</p>
								<a href="{{ path('app_view_sepia') }}" class="btn btn-danger mt-auto rounded-pill px-4">{{ 'home.card.sepia.button'|trans }}</a>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-4">
						<div class="action-card card h-100 shadow-sm card-coming-soon">
							<div class="card-body d-flex flex-column align-items-center justify-content-center">
								<div class="action-icon mb-3"><i class="fas fa-magic fa-3x text-info-disabled"></i></div>
								<h5 class="card-title">{{ 'home.card.next.title'|trans }}</h5>
								<p class="card-text text-muted small">{{ 'home.card.next.text'|trans }}</p>
								<button type="button" disabled class="btn btn-outline-secondary mt-auto rounded-pill px-4">{{ 'home.card.next.button'|trans }}</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		{% endblock %}
	</body>
</html>
