{% extends 'file/base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block header %}{{ 'home.heading'|trans }}{% endblock %}
{% block description %}{{ 'home.lead'|trans }}{% endblock %}

{% block content %}
	<ul class="papers">
		{% for tool in tools %}
			<li class="paper crop-marks">
				<a href="{{ path('app_view_' ~ tool.id) }}">
					<span class="paper-spec">{{ tool.spec }}</span>
					<span class="paper-title">{{ ('tools.' ~ tool.id)|trans }}</span>
					<span class="paper-text">{{ ('home.card.' ~ tool.id ~ '.text')|trans }}</span>
				</a>
			</li>
		{% endfor %}
	</ul>
{% endblock %}
