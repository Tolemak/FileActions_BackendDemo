{% extends 'file/file_action.html.twig' %}

{% set is_404 = status_code == 404 %}

{% block title_action %}{{ (is_404 ? 'error.404.header' : 'error.generic.header')|trans }}{% endblock %}
{% block header %}{{ (is_404 ? 'error.404.header' : 'error.generic.header')|trans }}{% endblock %}
{% block description %}{{ (is_404 ? 'error.404.description' : 'error.generic.description')|trans }}{% endblock %}

{% block sheet %}
	<p class="sheet-code">{{ status_code }}</p>
	<h2 class="sheet-title">{{ (is_404 ? 'error.404.text' : 'error.generic.text')|trans }}</h2>
	<p>{{ (is_404 ? 'error.404.subtext' : 'error.generic.subtext')|trans }}</p>
	<a href="{{ path('app_view_main') }}" class="cut-button">{{ 'common.back_home'|trans }}</a>
{% endblock %}
